#version 450
// M9b full-attention output gate (qwen3next): out[i] = x[i] * sigmoid(g[i]),
// elementwise over the whole attention output. attn_output_gate=true.
layout(local_size_x = 256) in;
layout(push_constant) uniform parameter { uint n; } p;
layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) readonly buffer G { float g[]; };
layout(binding = 2) buffer Out { float out_[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    out_[i] = x[i] * (1.0 / (1.0 + exp(-g[i])));
}
