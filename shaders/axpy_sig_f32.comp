#version 450
// d[i] += sigmoid(g[0]) * a[i] — shared-expert branch merge (qwen2moe).
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform parameter { uint n; } p;
layout(binding = 0) readonly buffer A { float data_a[]; };
layout(binding = 1) readonly buffer G { float gate[]; };
layout(binding = 2) buffer D { float data_d[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    float s = 1.0 / (1.0 + exp(-gate[0]));
    if (i < p.n) { data_d[i] += s * data_a[i]; }
}
