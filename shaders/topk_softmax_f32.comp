#version 450
// Softmax over n logits, then top-k selection with renormalized weights
// (Qwen3-MoE router: norm_topk_prob=true). Single workgroup; n <= 512.
//
// Writes FOUR id rows (each up to 16 i32s) in the ids buffer:
//   ids[0..k]     original expert ids (probe/debug, last_expert_ids)
//   ids[16+s]     hot id: dense hot-buffer index, SKIP when cold
//   ids[32+s]     arena id: GLOBAL arena slot (layer*k+slot) when the
//                 expert is cold AND was prefetched (pmap hit), else SKIP
//   ids[48+s]     gtt id: original expert id when cold AND NOT
//                 prefetched (arena miss fallback), else SKIP
// remap[e] = dense hot index for expert e, SKIP when not pinned hot.
// pmap[e]  = GLOBAL arena slot for expert e if it was prefetched into
//            the arena this token, SKIP otherwise (M7b-B). Uploaded
//            host-side from the previous token's routing prediction.
// Rows 16/32/48 partition every routed expert into exactly one of
// {hot, arena, gtt}; the patched mul_mat_vec_id_* kernels early-out on
// SKIP, so the three cold-path dispatches write disjoint output slots.
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform parameter { uint n; uint k; uint renorm; } p;
layout(binding = 0) readonly buffer L { float logits[]; };
layout(binding = 1) writeonly buffer W { float weights[]; };
layout(binding = 2) writeonly buffer I { int ids[]; };
layout(binding = 3) readonly buffer R { uint remap[]; };
layout(binding = 4) readonly buffer P { uint pmap[]; };

const uint SKIP = 0xFFFFFFFFu;

void main() {
    // serial: n=128 -> negligible vs the expert matvecs this gates
    float mx = logits[0];
    for (uint i = 1; i < p.n; ++i) mx = max(mx, logits[i]);
    float sum = 0.0;
    for (uint i = 0; i < p.n; ++i) sum += exp(logits[i] - mx);

    float picked[16];
    int pid[16];
    float wsum = 0.0;
    for (uint s = 0; s < p.k; ++s) {
        float best = -1.0 / 0.0;
        int bi = -1;
        for (uint i = 0; i < p.n; ++i) {
            bool taken = false;
            for (uint t = 0; t < s; ++t) if (pid[t] == int(i)) taken = true;
            if (!taken && logits[i] > best) { best = logits[i]; bi = int(i); }
        }
        float w = exp(best - mx) / sum;
        picked[s] = w;
        pid[s] = bi;
        wsum += w;
    }
    for (uint s = 0; s < p.k; ++s) {
        weights[s] = (p.renorm != 0u) ? picked[s] / wsum : picked[s];
        uint e = uint(pid[s]);
        ids[s] = pid[s];
        uint h = remap[e];
        if (h != SKIP) {
            ids[16 + s] = int(h);
            ids[32 + s] = int(SKIP);
            ids[48 + s] = int(SKIP);
        } else {
            uint a = pmap[e];
            ids[16 + s] = int(SKIP);
            ids[32 + s] = (a != SKIP) ? int(a) : int(SKIP);
            ids[48 + s] = (a != SKIP) ? int(SKIP) : pid[s];
        }
    }
}
